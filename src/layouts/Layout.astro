---
import Navbar from "../components/elements/Navbar.astro";
import Footer from "../components/elements/Footer.astro";
import { withBase } from "../utils/url";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ashish Kumar Jha — Backend Engineer (Java / Spring Boot)",
  description =
    "Backend engineer building Spring Boot services: multi-tenant architecture, " +
    "concurrency, and AWS deployments. Two years at Novoinvent Software.",
} = Astro.props;

// BASE_URL already carries a trailing slash. Using it avoids the `Astro.site`
// bug in v1, which produced `…/portfolio-web//asset` and loaded the LIVE site
// during local development.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta name="theme-color" content="#0C0C0E" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Ashish Kumar Jha",
      jobTitle: "Backend Engineer",
      worksFor: { "@type": "Organization", name: "Novoinvent Software" },
      knowsAbout: ["Java", "Spring Boot", "PostgreSQL", "Docker", "AWS", "Next.js"],
      url: "https://ashjha75.github.io/portfolio-web",
      sameAs: [
        "https://github.com/Ashjha75",
        "https://www.linkedin.com/in/ashish-kumar-jha-7b1b3b1b1/",
      ],
    })} />
  </head>

  <body class="bg-bg text-ink-2 antialiased overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100]
             focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg
             focus:font-medium"
    >
      Skip to content
    </a>

    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // --- Motion runtime -------------------------------------------------
      // Styles for [data-reveal] only apply once this class lands, so content
      // is always visible if JS fails and the H1 never paints at opacity 0.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (!reduced.matches) {
        document.documentElement.classList.add("js-motion");

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const i = Number(el.dataset.revealIndex ?? 0);
              el.style.setProperty("--reveal-delay", `${Math.min(i, 5) * 60}ms`);
              el.classList.add("is-in");
              io.unobserve(el); // reveal once — v1 re-hid on scroll-out
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );

        for (const el of document.querySelectorAll("[data-reveal]")) io.observe(el);
      }

      // --- Scroll progress + active nav section ----------------------------
      const bar = document.getElementById("scroll-progress");
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")];
      const sections = links
        .map((l) => document.querySelector<HTMLElement>(l.getAttribute("href") || ""))
        .filter((s): s is HTMLElement => Boolean(s));

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          if (bar) bar.style.transform = `scaleX(${max > 0 ? doc.scrollTop / max : 0})`;

          const line = window.scrollY + window.innerHeight * 0.3;
          let current = ""; // nothing active until a section is actually reached
          for (const s of sections) if (s.offsetTop <= line) current = s.id;

          for (const l of links) {
            const on = l.getAttribute("href") === `#${current}`;
            l.dataset.active = String(on);
          }

          // compact the header once past the hero
          document.getElementById("site-header")?.toggleAttribute(
            "data-scrolled",
            window.scrollY > 24
          );
          ticking = false;
        });
      };

      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
