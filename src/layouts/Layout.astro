---
import Navbar from "../components/elements/Navbar.astro";
import Footer from "../components/elements/Footer.astro";
import { withBase } from "../utils/url";
import { graph, SITE } from "../utils/structuredData";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ashish Kumar Jha — Backend Engineer (Java / Spring Boot)",
  description =
    "Backend engineer building Spring Boot services: multi-tenant architecture, " +
    "concurrency control and the data layer. Two years in the role at Novoinvent Software.",
} = Astro.props;

// BASE_URL already carries a trailing slash. Using it avoids the `Astro.site`
// bug in v1, which produced `…/portfolio-web//asset` and loaded the LIVE site
// during local development.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta name="theme-color" content="#0C0C0E" />

    <meta name="author" content="Ashish Kumar Jha" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Ashish Kumar Jha" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE + "/og.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ashish Kumar Jha — backend engineer, Java and Spring Boot" />
    <meta property="profile:first_name" content="Ashish" />
    <meta property="profile:last_name" content="Jha" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE + "/og.png"} />
    <meta name="twitter:creator" content="@ashish5jha" />

    {/* Machine-readable companions, advertised so agents can find them
        without guessing. See docs/05-seo-and-security.md. */}
    <link rel="alternate" type="text/plain" href={withBase("llms.txt")} title="Plain-text profile for LLMs" />
    <link rel="alternate" type="application/ld+json" href={withBase("profile.json")} title="schema.org profile" />
    <link rel="sitemap" type="application/xml" href={withBase("sitemap-index.xml")} />
    <link rel="me" href="https://github.com/Ashjha75" />
    <link rel="me" href="https://x.com/ashish5jha" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  </head>

  <body class="bg-bg text-ink-2 antialiased overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100]
             focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg
             focus:font-medium"
    >
      Skip to content
    </a>

    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // --- Motion runtime -------------------------------------------------
      // Styles for [data-reveal] only apply once this class lands, so content
      // is always visible if JS fails and the H1 never paints at opacity 0.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (!reduced.matches) {
        document.documentElement.classList.add("js-motion");

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const i = Number(el.dataset.revealIndex ?? 0);
              el.style.setProperty("--reveal-delay", `${Math.min(i, 6) * 70}ms`);
              el.classList.add("is-in");
              io.unobserve(el); // reveal once — v1 re-hid on scroll-out
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
        );

        // Anything marked [data-reveal] that has not been given an explicit
        // index gets one from its position among its reveal siblings, so a
        // grid or list cascades instead of every item landing at once.
        const groups = new Map<Element, number>();
        for (const el of document.querySelectorAll<HTMLElement>("[data-reveal]")) {
          if (el.dataset.revealIndex === undefined && el.parentElement) {
            const n = groups.get(el.parentElement) ?? 0;
            groups.set(el.parentElement, n + 1);
            el.dataset.revealIndex = String(n);
          }
          io.observe(el);
        }

        // Hero highlight sweeps in once the entrance animation has settled.
        setTimeout(() => {
          for (const el of document.querySelectorAll("#hero .hl")) el.classList.add("is-in");
        }, 1100);

        // Proof stats count up once when visible. The final text is always
        // the exact string from the data.
        const countIo = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              countIo.unobserve(el);
              const final = el.dataset.count ?? el.textContent ?? "";
              const m = /^(\d+)(.*)$/.exec(final);
              if (!m) continue;
              const target = Number(m[1]);
              const suffix = m[2];
              const dur = 1200;
              let start = 0;
              const step = (t: number) => {
                if (!start) start = t;
                const k = Math.min((t - start) / dur, 1);
                const eased = 1 - Math.pow(1 - k, 3);
                el.textContent = k < 1 ? `${Math.round(target * eased)}${suffix}` : final;
                if (k < 1) requestAnimationFrame(step);
              };
              el.textContent = `0${suffix}`;
              setTimeout(() => requestAnimationFrame(step), 450);
            }
          },
          { threshold: 0.6 }
        );
        for (const el of document.querySelectorAll<HTMLElement>("[data-count]")) countIo.observe(el);

        // Pointer spotlight in the hero: one gradient div moved by transform,
        // throttled to one write per frame, real pointers only.
        const hero = document.querySelector<HTMLElement>("[data-hero]");
        const spot = document.getElementById("hero-spot");
        if (hero && spot && window.matchMedia("(hover: hover)").matches) {
          let px = 0, py = 0, queued = false;
          const half = spot.offsetWidth / 2 || 280;
          const paint = () => {
            spot.style.transform = `translate3d(${px - half}px, ${py - half}px, 0)`;
            queued = false;
          };
          hero.addEventListener("pointermove", (e) => {
            const r = hero.getBoundingClientRect();
            px = e.clientX - r.left;
            py = e.clientY - r.top;
            if (!queued) { queued = true; requestAnimationFrame(paint); }
          }, { passive: true });
          hero.addEventListener("pointerenter", () => spot.classList.add("is-on"));
          hero.addEventListener("pointerleave", () => spot.classList.remove("is-on"));
        }
      }

      // --- Scroll progress + active nav section ----------------------------
      const bar = document.getElementById("scroll-progress");
      const field = document.getElementById("hero-parallax");
      const rail = document.getElementById("exp-rail");
      const railFill = document.getElementById("exp-rail-fill");
      const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")];
      const sections = links
        .map((l) => document.querySelector<HTMLElement>(l.getAttribute("href") || ""))
        .filter((s): s is HTMLElement => Boolean(s));

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          if (bar) bar.style.transform = `scaleX(${max > 0 ? doc.scrollTop / max : 0})`;

          const line = window.scrollY + window.innerHeight * 0.3;
          let current = ""; // nothing active until a section is actually reached
          for (const s of sections) if (s.offsetTop <= line) current = s.id;

          for (const l of links) {
            const on = l.getAttribute("href") === `#${current}`;
            l.dataset.active = String(on);
          }

          // compact the header once past the hero
          document.getElementById("site-header")?.toggleAttribute(
            "data-scrolled",
            window.scrollY > 24
          );

          // drift the hero field against the scroll, but only while it is on
          // screen — no point transforming an element nobody can see
          if (field && window.scrollY < window.innerHeight * 1.2) {
            field.style.transform = `translate3d(0, ${window.scrollY * 0.12}px, 0)`;
          }
          // experience rail fills as the list scrolls through the viewport
          if (rail && railFill && !reduced.matches) {
            const r = rail.getBoundingClientRect();
            const vh = window.innerHeight;
            const p = (vh * 0.7 - r.top) / Math.max(r.height, 1);
            railFill.style.transform = `scaleY(${Math.min(Math.max(p, 0), 1)})`;
          }
          ticking = false;
        });
      };

      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
