---
import Container from "../shared/Container.astro";
import { Icon } from "astro-icon/components";
import { profile } from "../../utils/profile";

const year = new Date().getFullYear();

const socials = [
  { label: "GitHub", href: profile.links.github, icon: "simple-icons:github" },
  { label: "LinkedIn", href: profile.links.linkedin, icon: "simple-icons:linkedin" },
  { label: "X", href: profile.links.x, icon: "simple-icons:x" },
  { label: "Email", href: "mailto:" + profile.email, icon: "lucide:mail" },
];

const nav = [
  { href: "#work", text: "Work" },
  { href: "#experience", text: "Experience" },
  { href: "#stack", text: "Stack" },
  { href: "#about", text: "About" },
  { href: "#contact", text: "Contact" },
];
---

<footer class="border-t border-line">
  <Container>
    <div class="flex flex-col gap-10 py-14 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5">
          <span class="grid h-7 w-7 place-items-center rounded-md border border-line-strong bg-surface-2 font-mono text-[11px] font-bold text-accent">AJ</span>
          <span class="font-display text-[15px] font-semibold text-ink">{profile.name}</span>
        </div>
        <p class="mt-4 text-sm text-ink-3">
          {profile.role} working in Java and Spring Boot. Currently at Novoinvent Software.
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="mono-label">Sections</h2>
        <ul class="mt-4 space-y-2.5">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-ink-2 transition-colors hover:text-accent">
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="mono-label">Elsewhere</h2>
        <ul class="mt-4 flex gap-2.5">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={s.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                class="grid h-10 w-10 place-items-center rounded-lg border border-line bg-surface-1 text-ink-2 transition-colors hover:border-accent/50 hover:text-accent"
              >
                <Icon name={s.icon} class="h-4 w-4" />
                <span class="sr-only">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-line py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[11px] tracking-wide text-ink-3">
        &copy; {year} {profile.name}
      </p>
      <p class="font-mono text-[11px] tracking-wide text-ink-3">
        Built with Astro &amp; Tailwind &middot;{" "}
        <a href="#hero" class="transition-colors hover:text-accent">Back to top</a>
      </p>
    </div>
  </Container>
</footer>
