---
import Container from "../shared/Container.astro";
import { profile } from "../../utils/profile";

const base = import.meta.env.BASE_URL;

const navItems = [
  { href: "#work", text: "Work" },
  { href: "#experience", text: "Experience" },
  { href: "#stack", text: "Stack" },
  { href: "#about", text: "About" },
  { href: "#contact", text: "Contact" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300
         data-[scrolled]:border-line data-[scrolled]:bg-bg/80 data-[scrolled]:backdrop-blur-md"
>
  <!-- scroll progress -->
  <div
    id="scroll-progress"
    class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-accent"
    aria-hidden="true"
  >
  </div>

  <Container>
    <nav class="flex h-16 items-center justify-between gap-6" aria-label="Primary">
      <!-- Wordmark: a fixed mark. v1 cycled "Engineer/Developer/Ashish" every 2s. -->
      <a href={base} class="group flex items-center gap-2.5 font-display text-ink">
        <span
          class="grid h-7 w-7 place-items-center rounded-md border border-line-strong
                 bg-surface-2 font-mono text-[11px] font-bold text-accent"
          >AJ</span
        >
        <span class="text-[15px] font-semibold tracking-tight">Ashish Kumar Jha</span>
      </a>

      <!-- desktop links -->
      <ul class="hidden items-center gap-1 lg:flex">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav-link
              class="rounded-md px-3 py-2 text-sm text-ink-2 transition-colors hover:text-ink
                     data-[active=true]:text-accent"
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={profile.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden rounded-md px-3 py-2 text-sm text-ink-2 transition-colors hover:text-ink sm:block"
          >GitHub</a
        >
        <a
          href={`${base}resume.pdf`}
          download="Ashish-Kumar-Jha-Resume.pdf"
          class="rounded-lg border border-line-strong px-4 py-2 text-sm font-medium text-ink
                 transition-colors hover:border-accent hover:text-accent"
          >Résumé</a
        >

        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="grid h-10 w-10 place-items-center rounded-lg border border-line-strong lg:hidden"
        >
          <span class="sr-only">Toggle menu</span>
          <span class="relative block h-3 w-4" aria-hidden="true">
            <span class="bar absolute left-0 top-0 h-px w-4 bg-ink transition-transform duration-300"></span>
            <span class="bar absolute left-0 top-1.5 h-px w-4 bg-ink transition-opacity duration-300"></span>
            <span class="bar absolute left-0 top-3 h-px w-4 bg-ink transition-transform duration-300"></span>
          </span>
        </button>
      </div>
    </nav>
  </Container>

  <!-- mobile panel -->
  <div
    id="mobile-nav"
    hidden
    class="border-t border-line bg-bg/95 backdrop-blur-md lg:hidden"
  >
    <Container>
      <ul class="flex flex-col py-4">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-mobile-link
              class="block border-b border-line/60 py-3.5 text-[15px] text-ink-2 hover:text-accent"
            >
              {item.text}
            </a>
          </li>
        ))}
        <li>
          <a
            href={profile.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="block py-3.5 text-[15px] text-ink-2 hover:text-accent">GitHub</a
          >
        </li>
      </ul>
    </Container>
  </div>
</header>

<style>
  [data-menu-toggle][aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  [data-menu-toggle][aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }
  [data-menu-toggle][aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.getElementById("mobile-nav");

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
  };

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  // close after choosing a destination
  for (const link of document.querySelectorAll("[data-mobile-link]")) {
    link.addEventListener("click", () => setOpen(false));
  }

  // close when leaving mobile width, so the panel can't get stuck hidden-open
  const mq = window.matchMedia("(min-width: 1024px)");
  mq.addEventListener("change", (e) => e.matches && setOpen(false));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
