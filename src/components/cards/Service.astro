---
// src/cards/Service.astro
import { Icon } from 'astro-icon/components';

export interface Props {
    title: string;
    description: string;
    icon: string; // The icon name, e.g., "lucide:code-2"
}

const { title, description, icon } = Astro.props;
---
<div class="group relative overflow-hidden rounded-xl border border-stone-200 bg-white/60 p-6 text-center transition-all duration-300 ease-in-out hover:-translate-y-2 hover:shadow-lg hover:shadow-stone-200">
    
    <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-skill-card transition-colors duration-300 group-hover:bg-brand-green/20">
        <Icon name={icon} class="h-8 w-8 text-brand-green" />
    </div>

    <div class="space-y-2">
        <h3 class="text-xl font-bold text-brand-green">
            {title}
        </h3>
        <p class="text-stone-600">
            {description}
        </p>
    </div>
</div>