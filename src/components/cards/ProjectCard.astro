---
import type { Project } from "../../utils/projects";
import { Icon } from "astro-icon/components";
import Tag from "../shared/Tag.astro";
import ArchDiagram from "../diagrams/ArchDiagram.astro";

export interface Props {
  project: Project;
  index?: number;
  /** Lead card: full width, diagram beside the copy instead of above it. */
  wide?: boolean;
}
const { project, index = 0, wide = false } = Astro.props;
---

<article
  class:list={[
    "group lift h-full overflow-hidden rounded-2xl border border-line bg-surface-1",
    "hover:border-accent/45",
    wide ? "md:grid md:grid-cols-[1.05fr_1fr]" : "flex flex-col",
  ]}
  data-reveal
  data-reveal-index={index}
>
  <!-- The architecture panel: replaces the identical folder icon v1 used. -->
  <div
    class:list={[
      "relative bg-bg/40 px-4 pt-4 pb-3 sm:px-5 sm:pt-5 sm:pb-4",
      wide ? "border-b border-line md:border-b-0 md:border-r md:flex md:flex-col" : "border-b border-line",
    ]}
  >
    <div class="mb-3 flex items-center justify-between">
      <span class="mono-label">{project.kind}</span>
      {project.featured && (
        <span class="rounded-full border border-accent/30 bg-accent/[0.08] px-2 py-0.5 font-mono text-[10px] tracking-wide text-accent">
          FEATURED
        </span>
      )}
    </div>
    <div class:list={[wide ? "md:flex md:flex-1 md:items-center" : ""]}>
      <ArchDiagram kind={project.diagram} />
    </div>
  </div>

  <div class="flex flex-1 flex-col p-4 sm:p-6">
    <h3 class="text-[length:var(--text-h3)] font-semibold text-ink">{project.title}</h3>
    <p class="mt-2.5 text-[1rem] leading-relaxed text-ink-2">{project.summary}</p>

    <ul class="mt-5 space-y-2.5">
      {project.highlights.map((h) => (
        <li class="flex gap-2.5 text-[0.9375rem] leading-relaxed text-ink-2">
          <span class="mt-[0.55rem] h-px w-3 shrink-0 bg-accent/60" aria-hidden="true" />
          <span>{h}</span>
        </li>
      ))}
    </ul>

    <!-- mt-auto pins the footer so every card in a row ends level -->
    <div class="mt-auto pt-5">
      <div class="flex flex-wrap gap-1.5">
        {project.stack.map((s) => <Tag>{s}</Tag>)}
      </div>

      <div class="mt-5 flex items-center gap-4 border-t border-line pt-4">
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center gap-2 text-sm font-medium text-ink-2 hover:text-accent"
          >
            <Icon name="lucide:github" class="h-4 w-4" />
            Source
          </a>
        )}
        {project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-2 transition-colors hover:text-accent"
          >
            <Icon name="lucide:external-link" class="h-4 w-4" />
            Live
          </a>
        )}
      </div>
    </div>
  </div>
</article>
