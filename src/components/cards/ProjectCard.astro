---
import type { Project } from "../../utils/projects";
import { Icon } from "astro-icon/components";
import Tag from "../shared/Tag.astro";
import ArchDiagram from "../diagrams/ArchDiagram.astro";

export interface Props { project: Project; index?: number }
const { project, index = 0 } = Astro.props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface-1
         transition-colors duration-300 hover:border-line-strong"
  data-reveal
  data-reveal-index={index}
>
  <!-- the architecture panel replaces the identical folder icon every v1 card had -->
  <div class="relative border-b border-line bg-bg/40 px-5 pt-5 pb-4">
    <div class="mb-3 flex items-center justify-between">
      <span class="mono-label">{project.kind}</span>
      {project.featured && (
        <span class="rounded-full border border-accent/30 bg-accent/[0.08] px-2 py-0.5
                     font-mono text-[10px] tracking-wide text-accent">
          FEATURED
        </span>
      )}
    </div>
    <ArchDiagram kind={project.diagram} />
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="text-[length:var(--text-h3)] font-semibold text-ink">{project.title}</h3>
    <p class="mt-2.5 text-[0.9375rem] text-ink-2">{project.summary}</p>

    <ul class="mt-5 space-y-2.5">
      {project.highlights.map((h) => (
        <li class="flex gap-2.5 text-[0.875rem] leading-relaxed text-ink-2">
          <span class="mt-[0.55rem] h-px w-3 shrink-0 bg-accent/60" aria-hidden="true" />
          <span>{h}</span>
        </li>
      ))}
    </ul>

    <!-- mt-auto pins the footer so every card ends at the same place -->
    <div class="mt-auto pt-6">
      <div class="flex flex-wrap gap-1.5">
        {project.stack.map((s) => <Tag>{s}</Tag>)}
      </div>

      <div class="mt-5 flex items-center gap-4 border-t border-line pt-4">
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-2 transition-colors hover:text-accent"
          >
            <Icon name="lucide:github" class="h-4 w-4" />
            Source
          </a>
        )}
        {project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-ink-2 transition-colors hover:text-accent"
          >
            <Icon name="lucide:external-link" class="h-4 w-4" />
            Live
          </a>
        )}
      </div>
    </div>
  </div>
</article>
