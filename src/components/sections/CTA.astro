---
import Container from "../shared/Container.astro";
import experienceData, { getFormattedDate } from "../../utils/experience";
import { Icon } from "astro-icon/components";
---

<section id="experience" class="pb-20 scroll-animation">
  <Container>
    <div
      class="relative w-full max-w-6xl mx-auto p-8 md:p-10 rounded-2xl bg-white dark:bg-gray-900/70 backdrop-blur-sm border border-gray-200 dark:border-gray-800 shadow-lg shadow-gray-200/20 dark:shadow-gray-900/20 overflow-hidden"
    >
      <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary/10 rounded-full blur-xl"></div>
      <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-green-500/10 rounded-full blur-xl"></div>
      
      <div class="relative z-10">
        <h2 class="text-3xl font-bold text-center text-heading-1 mb-12">My Experience</h2>
        
        <div class="space-y-12">
          {experienceData.map(exp => (
            <div>
              <div class="flex items-center gap-4">
                <h3 class="text-xl font-bold text-green-600 dark:text-green-400">{exp.role}</h3>
                <span class="text-gray-400 dark:text-gray-500">|</span>
                <a href={exp.companyUrl} target="_blank" rel="noopener noreferrer" class="text-xl font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2">
                  {exp.company}
                  <Icon name="lucide:external-link" class="w-5 h-5" />
                </a>
              </div>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-2 bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full w-max">
                {getFormattedDate(exp.startDate)} - {getFormattedDate(exp.endDate)}
              </p>
              <ul class="mt-6 space-y-4">
                {exp.responsibilities.map(resp => (
                  <li class="bg-gray-50 dark:bg-gray-800/50 p-4 rounded-lg shadow-sm">
                    <p class="text-gray-700 dark:text-gray-300 flex items-start">
                      <span class="text-red-500 mr-3 mt-1">•</span>
                      {resp}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
