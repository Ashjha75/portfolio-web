---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import ByNumber from "./ByNumber.astro";
---

<section id="hero" class="relative pt-32 lg:pt-36">
    <div class="absolute w-full lg:w-1/2 inset-y-0 lg:right-0 ">
        <span class="absolute -left-6 md:left-4 top-24 lg:top-28 w-24 h-24 rotate-90 skew-x-12 rounded-3xl bg-green-400 blur-xl opacity-60 lg:opacity-95 lg:block hidden"></span>
        <span class="absolute right-4 bottom-12 w-24 h-24 rounded-3xl bg-primary blur-xl opacity-80"></span>
    </div>
    <span class="w-4/12 lg:w-2/12 aspect-square bg-gradient-to-tr from-primary to-green-400 absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"></span>
    <Container className={"relative z-10"}>
        <div class="mx-auto text-center max-w-4xl">
            <div class="hero-content opacity-0 transform translate-y-8 transition-all duration-700 ease-in-out">
                <h1 class="text-4xl/tight sm:text-5xl/tight md:text-6xl/tight xl:text-7xl/tight
                 font-bold text-heading-1">
                 Ashish Kumar Jha: <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600">Engineering</span> Robust
    Web Applications.
                </h1>
                <Paragraph className="mt-8 text-lg">
                    Passionate about transforming complex challenges into elegant, efficient code. I leverage the power of Angular and Spring Boot to architect and build end-to-end web solutions that are not only functional and secure but also provide a seamless user experience.
                </Paragraph>
                <div class="mt-12 flex justify-center gap-6">
                    <BtnLink href="#projects" text="View My Work" />
                    <BtnLink href="#contact" text="Get In Touch" variant="secondary" />
                </div>
            </div>
        </div>
    </Container>

    <ByNumber/>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const heroContent = document.querySelector('.hero-content');
        if (heroContent) {
            setTimeout(() => {
                heroContent.classList.remove('opacity-0', 'translate-y-8');
                heroContent.classList.add('opacity-100', 'translate-y-0');
            }, 100);
        }
    });
</script>
