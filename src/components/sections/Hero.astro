---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import ByNumber from "./ByNumber.astro";
---

<section id="hero" class="relative pt-32 lg:pt-36 overflow-hidden">
    <!-- Animated background blobs -->
    <div class="absolute w-full lg:w-1/2 inset-y-0 lg:right-0 ">
        <span class="blob-1 absolute -left-6 md:left-4 top-24 lg:top-28 w-24 h-24 rotate-90 skew-x-12 rounded-3xl bg-green-400 blur-xl opacity-60 lg:opacity-95"></span>
        <span class="blob-2 absolute right-4 bottom-12 w-24 h-24 rounded-3xl bg-primary blur-xl opacity-80"></span>
    </div>
    <span class="blob-3 w-4/12 lg:w-2/12 aspect-square bg-gradient-to-tr from-primary to-green-400 absolute -top-5 lg:left-0 rounded-full skew-y-12 blur-2xl opacity-40 skew-x-12 rotate-90"></span>
    
    <!-- Floating particles -->
    <div class="particles absolute inset-0 pointer-events-none">
        <span class="particle"></span>
        <span class="particle"></span>
        <span class="particle"></span>
        <span class="particle"></span>
        <span class="particle"></span>
    </div>

    <Container className={"relative z-10"}>
        <div class="mx-auto text-center max-w-4xl">
            <div class="hero-content">
                <!-- Animated heading with staggered reveal -->
                <h1 class="text-4xl/tight sm:text-5xl/tight md:text-6xl/tight xl:text-7xl/tight font-bold text-heading-1 overflow-hidden">
                    <span class="reveal-line block">Ashish Kumar Jha:</span>
                    <span class="reveal-line block">
                        <span class="text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 from-20% via-primary via-30% to-green-600 gradient-animate">Engineering</span>
                    </span>
                    <span class="reveal-line block">Robust Web Applications.</span>
                </h1>
                
                <div class="fade-in-up" style="animation-delay: 0.6s;">
                    <Paragraph className="mt-8 text-lg">
                        Passionate about transforming complex challenges into elegant, efficient code. I leverage the power of Angular and Spring Boot to architect and build end-to-end web solutions that are not only functional and secure but also provide a seamless user experience.
                    </Paragraph>
                </div>
                
                <div class="mt-12 flex justify-center gap-6 fade-in-up" style="animation-delay: 0.9s;">
                    <BtnLink href="#projects" text="View My Work" />
                    <BtnLink href="#contact" text="Get In Touch" variant="secondary" />
                </div>
            </div>
        </div>
    </Container>

    <ByNumber/>
</section>

<style>
    /* Blob animations */
    .blob-1 {
        animation: float 6s ease-in-out infinite;
    }
    
    .blob-2 {
        animation: float 8s ease-in-out infinite;
        animation-delay: 1s;
    }
    
    .blob-3 {
        animation: float 10s ease-in-out infinite;
        animation-delay: 2s;
    }
    
    @keyframes float {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-20px) rotate(5deg);
        }
    }
    
    /* Gradient animation */
    .gradient-animate {
        background-size: 200% 200%;
        animation: gradient-shift 3s ease infinite;
    }
    
    @keyframes gradient-shift {
        0%, 100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }
    
    /* Reveal line animation */
    .reveal-line {
        opacity: 0;
        transform: translateY(30px);
        animation: reveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    
    .reveal-line:nth-child(1) {
        animation-delay: 0.1s;
    }
    
    .reveal-line:nth-child(2) {
        animation-delay: 0.3s;
    }
    
    .reveal-line:nth-child(3) {
        animation-delay: 0.5s;
    }
    
    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Fade in up animation */
    .fade-in-up {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    
    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Floating particles */
    .particles {
        z-index: 1;
    }
    
    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(99, 102, 241, 0.5);
        border-radius: 50%;
        animation: particle-float 15s infinite;
    }
    
    .particle:nth-child(1) {
        left: 10%;
        top: 20%;
        animation-delay: 0s;
    }
    
    .particle:nth-child(2) {
        left: 80%;
        top: 30%;
        animation-delay: 2s;
    }
    
    .particle:nth-child(3) {
        left: 30%;
        top: 60%;
        animation-delay: 4s;
    }
    
    .particle:nth-child(4) {
        left: 70%;
        top: 70%;
        animation-delay: 6s;
    }
    
    .particle:nth-child(5) {
        left: 50%;
        top: 40%;
        animation-delay: 8s;
    }
    
    @keyframes particle-float {
        0%, 100% {
            transform: translate(0, 0);
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        90% {
            opacity: 1;
        }
        100% {
            transform: translate(100px, -100px);
            opacity: 0;
        }
    }
    
    /* Hover effects on buttons */
    :global(.btn-link) {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    :global(.btn-link:hover) {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Smooth scroll for anchor links
        const links = document.querySelectorAll('a[href^="#"]');
        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const target = document.querySelector(link.getAttribute('href') || '');
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    });
</script>