---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import Button from "../shared/Button.astro";

// Use environment variable for Formspree endpoint, fallback to default
const FORMSPREE_ENDPOINT = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || "https://formspree.io/f/meorvdbg";
---

<section id="contact" class="pb-20 scroll-animation">
  <Container>
    <div
      id="contact-card"
      class="relative w-full max-w-4xl mx-auto p-8 md:p-10 rounded-2xl bg-white dark:bg-gray-900/70 backdrop-blur-sm border border-gray-200 dark:border-gray-800 shadow-lg shadow-gray-200/20 dark:shadow-gray-900/20 overflow-hidden"
    >
      <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary/10 rounded-full blur-xl"></div>
      <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-green-500/10 rounded-full blur-xl"></div>
      
      <div class="relative z-10 text-center">
        <Title>Contact Me</Title>
        <Paragraph className="mt-4">
          I'm always open to discussing new projects, creative ideas, or opportunities to be part of your visions.
        </Paragraph>

  <form id="contact-form" action={FORMSPREE_ENDPOINT} method="POST" class="mt-10 max-w-lg mx-auto text-left">
          <div class="grid grid-cols-1 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Name</label>
              <input type="text" id="name" name="name" required class="mt-1 block w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border-transparent rounded-md focus:ring-primary focus:border-primary dark:focus:ring-offset-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
              <input type="email" id="email" name="email" required class="mt-1 block w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border-transparent rounded-md focus:ring-primary focus:border-primary dark:focus:ring-offset-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400">
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Message</label>
              <textarea id="message" name="message" rows="4" required class="mt-1 block w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border-transparent rounded-md focus:ring-primary focus:border-primary dark:focus:ring-offset-gray-900 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400"></textarea>
            </div>
            <!-- Honeypot field to prevent spam -->
            <input type="text" name="_gotcha" style="display:none" />
            <div class="text-center">
              <Button type="submit" variant="primary">
                <span class="text-white relative z-[5]">Send Message</span>
              </Button>
            </div>
          </div>
        </form>

        <!-- Simple Form Submission Message -->
        <div id="form-message" class="mt-4 text-center opacity-0 transform translate-y-2 transition-all duration-500">
          <div class="inline-flex items-center px-4 py-2 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
            <svg class="w-5 h-5 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-sm font-medium text-green-800 dark:text-green-200">Message sent successfully!</span>
          </div>
        </div>

        <!-- Social Links Section -->
        <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
          <Paragraph className="mb-6 text-center">
            Or connect with me directly:
          </Paragraph>

          <div class="flex justify-center items-center space-x-8">
            <!-- Email -->
            <a
              href={`mailto:${import.meta.env.PUBLIC_CONTACT_EMAIL || 'network.ashishjha@gmail.com'}`}
              class="group flex flex-col items-center justify-center w-20 h-20 rounded-2xl bg-gray-50 dark:bg-gray-800/50 hover:bg-primary/5 dark:hover:bg-primary/10 transition-all duration-300 hover:scale-110 hover:-translate-y-1"
              aria-label="Send email"
            >
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 group-hover:bg-primary/20 transition-all duration-300 mb-1">
                <svg class="w-5 h-5 text-primary group-hover:scale-125 group-hover:rotate-12 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-primary transition-colors duration-300">Email</span>
            </a>

            <!-- GitHub -->
            <a
              href="https://github.com/Ashjha75"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center justify-center w-20 h-20 rounded-2xl bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-900/10 dark:hover:bg-gray-700/30 transition-all duration-300 hover:scale-110 hover:-translate-y-1"
              aria-label="View GitHub Profile"
            >
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-900/10 dark:bg-gray-700/30 group-hover:bg-gray-900/20 dark:group-hover:bg-gray-600/40 transition-all duration-300 mb-1">
                <svg class="w-5 h-5 text-gray-900 dark:text-gray-100 group-hover:scale-125 group-hover:rotate-12 transition-all duration-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-gray-900 dark:group-hover:text-gray-100 transition-colors duration-300">GitHub</span>
            </a>

            <!-- Twitter / X -->
            <a
              href="https://x.com/ashish5jha"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center justify-center w-20 h-20 rounded-2xl bg-gray-50 dark:bg-gray-800/50 hover:bg-blue-50 dark:hover:bg-blue-900/10 transition-all duration-300 hover:scale-110 hover:-translate-y-1"
              aria-label="Follow on X (Twitter)"
            >
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-blue-50 dark:bg-blue-900/20 group-hover:bg-blue-100 dark:group-hover:bg-blue-900/30 transition-all duration-300 mb-1">
                <svg class="w-5 h-5 text-blue-500 group-hover:scale-125 group-hover:rotate-12 transition-all duration-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-blue-500 transition-colors duration-300">X</span>
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/ashish5jha/"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col items-center justify-center w-20 h-20 rounded-2xl bg-gray-50 dark:bg-gray-800/50 hover:bg-blue-50 dark:hover:bg-blue-900/10 transition-all duration-300 hover:scale-110 hover:-translate-y-1"
              aria-label="Connect on LinkedIn"
            >
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-blue-50 dark:bg-blue-900/20 group-hover:bg-blue-100 dark:group-hover:bg-blue-900/30 transition-all duration-300 mb-1">
                <svg class="w-5 h-5 text-blue-600 group-hover:scale-125 group-hover:rotate-12 transition-all duration-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 group-hover:text-blue-600 transition-colors duration-300">LinkedIn</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </Container>
</section>

<script define:vars={{ FORMSPREE_ENDPOINT }}>
  // Simple message functions
  function showSuccessMessage() {
    const messageEl = document.getElementById('form-message');
    if (!messageEl) return;

    // Show message with animation
    messageEl.classList.remove('opacity-0', 'translate-y-2');
    messageEl.classList.add('opacity-100', 'translate-y-0');

    // Hide after 5 seconds
    setTimeout(() => {
      hideMessage();
    }, 5000);
  }

  function showErrorMessage() {
    const messageEl = document.getElementById('form-message');
    if (!messageEl) return;

    // Update message for error
    const messageText = messageEl.querySelector('span');
    const messageDiv = messageEl.querySelector('div');

    if (messageText && messageDiv) {
      messageText.textContent = 'Failed to send message. Please try again.';
      messageDiv.classList.remove('bg-green-50', 'dark:bg-green-900/20', 'border-green-200', 'dark:border-green-800', 'text-green-800', 'dark:text-green-200');
      messageDiv.classList.add('bg-red-50', 'dark:bg-red-900/20', 'border-red-200', 'dark:border-red-800', 'text-red-800', 'dark:text-red-200');

      // Update icon for error
      const icon = messageDiv.querySelector('svg');
      if (icon) {
        icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>`;
        icon.classList.remove('text-green-400');
        icon.classList.add('text-red-400');
      }
    }

    // Show message with animation
    messageEl.classList.remove('opacity-0', 'translate-y-2');
    messageEl.classList.add('opacity-100', 'translate-y-0');

    // Hide after 5 seconds
    setTimeout(() => {
      hideMessage();
    }, 5000);
  }

  function hideMessage() {
    const messageEl = document.getElementById('form-message');
    if (!messageEl) return;

    messageEl.classList.remove('opacity-100', 'translate-y-0');
    messageEl.classList.add('opacity-0', 'translate-y-2');
  }

  // Form submission handler
  const contactForm = document.getElementById('contact-form');
  if (contactForm) {
    contactForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      const form = contactForm;
      if (!form) return;

      const submitButton = form.querySelector('button[type="submit"]');
      if (!submitButton) return;

      // Show loading state
      submitButton.disabled = true;
      submitButton.innerHTML = '<span class="text-white relative z-[5]">Sending...</span>';

      try {
        // Collect form data
        const formData = new FormData(form);

        // Submit to Formspree
        const response = await fetch(FORMSPREE_ENDPOINT, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          // Success - Show simple animated message
          showSuccessMessage();

          // Clear form
          form.reset();

          // Reset button
          submitButton.disabled = false;
          submitButton.innerHTML = '<span class="text-white relative z-[5]">Send Message</span>';
        } else {
          throw new Error('Failed to send message');
        }
      } catch (error) {
        // Error - Show error message
        showErrorMessage();

        // Reset button
        submitButton.disabled = false;
        submitButton.innerHTML = '<span class="text-white relative z-[5]">Send Message</span>';
      }
    });
  }
</script>
