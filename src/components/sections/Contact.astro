---
import Section from "../shared/Section.astro";
import Button from "../shared/Button.astro";
import { Icon } from "astro-icon/components";
import { profile } from "../../utils/profile";

const FORMSPREE_ENDPOINT =
  import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || "https://formspree.io/f/xyzbygjw";

const mailto = "mailto:" + profile.email;

const channels = [
  { label: "Email", value: profile.email, href: mailto, icon: "lucide:mail", external: false },
  { label: "X", value: "@ashish5jha", href: profile.links.x, icon: "simple-icons:x", external: true },
  { label: "LinkedIn", value: "in/ashish-kumar-jha", href: profile.links.linkedin, icon: "simple-icons:linkedin", external: true },
  { label: "GitHub", value: "Ashjha75", href: profile.links.github, icon: "simple-icons:github", external: true },
];
---

<Section
  id="contact"
  eyebrow="Contact"
  title="Hiring for a backend role?"
  lead="Email is the fastest way to reach me. The form works too, if you would rather not open a mail client."
>
  <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
    <!-- Direct channels first: a recruiter wants to click, not fill in a form. -->
    <div data-reveal>
      <ul class="space-y-3">
        {channels.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.external ? "_blank" : undefined}
              rel={c.external ? "noopener noreferrer" : undefined}
              class="group lift flex items-center gap-4 rounded-xl border border-line bg-surface-1 p-4 hover:border-accent/50"
            >
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-line bg-surface-2">
                <Icon name={c.icon} class="h-4 w-4 text-ink-2 transition-colors group-hover:text-accent" />
              </span>
              <span class="min-w-0">
                <span class="mono-label block">{c.label}</span>
                <span class="mt-0.5 block truncate text-sm text-ink">{c.value}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        data-copy-email
        data-email={profile.email}
        class="mt-4 inline-flex items-center gap-2 font-mono text-[12px] text-ink-3 transition-colors hover:text-accent"
      >
        <Icon name="lucide:copy" class="h-3.5 w-3.5" />
        <span data-copy-label>Copy email address</span>
      </button>
    </div>

    <form
      id="contact-form"
      action={FORMSPREE_ENDPOINT}
      method="POST"
      class="rounded-2xl border border-line bg-surface-1 p-6 sm:p-7"
      data-reveal
      data-reveal-index="1"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="mono-label">Name</label>
          <input
            type="text" id="name" name="name" required autocomplete="name"
            placeholder="Jane Doe"
            class="mt-2 w-full rounded-lg border border-line bg-surface-2 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:border-accent focus:outline-none"
          />
        </div>
        <div>
          <label for="email" class="mono-label">Email</label>
          <input
            type="email" id="email" name="email" required autocomplete="email"
            placeholder="jane@company.com"
            class="mt-2 w-full rounded-lg border border-line bg-surface-2 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:border-accent focus:outline-none"
          />
        </div>
      </div>

      <div class="mt-5">
        <label for="message" class="mono-label">Message</label>
        <textarea
          id="message" name="message" rows="5" required
          placeholder="A line about the role or the team."
          class="mt-2 w-full resize-y rounded-lg border border-line bg-surface-2 px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:border-accent focus:outline-none"
        ></textarea>
      </div>

      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <Button type="submit" variant="primary">Send message</Button>
        <p id="form-message" role="status" aria-live="polite" class="text-sm text-ink-3"></p>
      </div>
    </form>
  </div>
</Section>

<script>
  const copyBtn = document.querySelector("[data-copy-email]") as HTMLButtonElement | null;
  copyBtn?.addEventListener("click", async () => {
    const label = copyBtn.querySelector("[data-copy-label]");
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.email || "");
      if (label) label.textContent = "Copied";
    } catch {
      if (label) label.textContent = "Press Ctrl+C to copy";
    }
    setTimeout(() => {
      if (label) label.textContent = "Copy email address";
    }, 2000);
  });

  // Async submit so the page never navigates away to Formspree.
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-message");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    if (!status || !button) return;

    const original = button.textContent;
    button.disabled = true;
    button.textContent = "Sending...";
    status.textContent = "";
    status.className = "text-sm text-ink-3";

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = "Thanks - I will get back to you.";
      status.className = "text-sm text-signal";
    } catch {
      status.textContent = "Could not send. Email me directly instead.";
      status.className = "text-sm text-accent";
    } finally {
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>
