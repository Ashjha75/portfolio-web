---
// filepath: src/components/sections/CompanyLogos.astro
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { Icon } from 'astro-icon/components';
import { companyLogos } from "../../utils/companyLogos.ts";
---

<section id="company-logos" class="scroll-animation py-20">
    <Container className="space-y-12">
        <div class="text-center max-w-3xl mx-auto fade-in">
            <Title>
                My Tech Stack & Skills
            </Title>
        </div>
        <div class="flex justify-center flex-wrap gap-4 md:gap-6">
            {
                companyLogos.map((logo, index) => (
                    <div 
                        class="tech-card p-4 sm:p-5 rounded-xl bg-body border transition-all duration-500 border-box-border dark:border-[#292237] group flex items-center gap-x-3 hover:-translate-y-2 hover:shadow-xl dark:hover:shadow-2xl dark:hover:shadow-primary/20 hover:border-primary/50 dark:hover:border-primary/50 cursor-pointer opacity-0 translate-y-8"
                        style={`animation-delay: ${index * 0.1}s;`}
                    >
                        <Icon 
                            name={logo.icon} 
                            class="h-7 sm:h-8 w-auto text-heading-1 ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-110 group-hover:rotate-6" 
                        />
                        
                        { !logo.icon.includes('paypal') && !logo.icon.includes('google') && !logo.icon.includes('netflix') && (
                            <span class="text-base sm:text-lg font-semibold text-heading-2 ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:text-primary">
                                {logo.name}
                            </span>
                        )}
                    </div>
                ))
            }
        </div>
    </Container>
</section>

<style>
    /* Fade in animation for title */
    .fade-in {
        animation: fadeIn 1s ease-out forwards;
    }
    
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Staggered card entrance animation */
    .tech-card {
        animation: slideInUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    
    @keyframes slideInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Smooth hover transitions with scale and glow */
    .tech-card {
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
    }
    
    /* Shimmer effect on hover */
    .tech-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(99, 102, 241, 0.1),
            transparent
        );
        transition: left 0.5s ease;
    }
    
    .tech-card:hover::before {
        left: 100%;
    }
    
    /* Glow effect on hover */
    .tech-card:hover {
        box-shadow: 
            0 10px 40px rgba(99, 102, 241, 0.2),
            0 0 20px rgba(99, 102, 241, 0.1) inset;
    }
    
    /* Icon rotation animation */
    @keyframes iconFloat {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-5px) rotate(3deg);
        }
    }
    
    .tech-card:hover :global(svg) {
        animation: iconFloat 0.6s ease-in-out;
    }
</style>

<script>
    // Intersection Observer for scroll animations
    document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -100px 0px'
        });
        
        const cards = document.querySelectorAll('.tech-card');
        cards.forEach(card => observer.observe(card));
    });
</script>
