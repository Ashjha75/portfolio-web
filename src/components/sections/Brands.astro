---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { Icon } from 'astro-icon/components';

import { companyLogos } from "../../utils/companyLogos.ts";
---

<section id="company-logos">
    <Container className="space-y-8">
        <div class="text-center max-w-3xl mx-auto">
            <Title>
                Trusted by companies like
            </Title>
        </div>
        <div class="flex justify-center flex-wrap gap-4">
            {
                companyLogos.map((logo) => (
                    // The outer div's classes remain the same.
                    // We add `flex items-center` to align the icon and text horizontally.
                    <div class="p-4 sm:p-5 rounded-xl bg-body border border-box-border group flex items-center gap-x-3">
                        
                        {/* The Icon component's classes are slightly adjusted for size */}
                        <Icon 
                            name={logo.icon} 
                            class="h-7 sm:h-8 w-auto ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105 text-brand-green" 
                        />

                        {/* We add the text here, unless the icon name already contains it */}
                        { !logo.icon.includes('paypal') && !logo.icon.includes('google') && !logo.icon.includes('netflix') && (
                            <span class="text-lg font-semibold text-heading-2 ease-linear duration-300 grayscale group-hover:!grayscale-0">
                                {logo.name}
                            </span>
                        )}
                    </div>
                ))
            }
        </div>
    </Container>
</section>