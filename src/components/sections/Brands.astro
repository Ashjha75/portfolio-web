---
// filepath: src/components/sections/CompanyLogos.astro
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import { Icon } from 'astro-icon/components';
import { companyLogos } from "../../utils/companyLogos.ts";
---

<section id="company-logos">
    <Container className="space-y-8">
        <div class="text-center max-w-3xl mx-auto">
            <Title>
                My Tech Stack & Skills
            </Title>
        </div>
        <div class="flex justify-center flex-wrap gap-4">
            {
                companyLogos.map((logo) => (
                    // Updated classes for border, background, and hover effect
                    <div class="p-4 sm:p-5 rounded-xl bg-body border transition-all duration-300
                                border-box-border dark:border-[#292237] group flex items-center gap-x-3
                                hover:-translate-y-1 hover:shadow-md dark:hover:shadow-lg dark:hover:shadow-blue-500/20">
                        
                        {/* Icon with grayscale hover effect */}
                        <Icon 
                            name={logo.icon} 
                            class="h-7 sm:h-8 w-auto text-heading-1 ease-linear duration-300 grayscale group-hover:!grayscale-0 group-hover:scale-105" 
                        />

                        {/* Text with the same grayscale effect and correct color handling */}
                        { !logo.icon.includes('paypal') && !logo.icon.includes('google') && !logo.icon.includes('netflix') && (
                            <span class="text-lg font-semibold text-heading-2 ease-linear duration-300 grayscale group-hover:!grayscale-0">
                                {logo.name}
                            </span>
                        )}

                    </div>
                ))
            }
        </div>
    </Container>
</section>