---
import Section from "../shared/Section.astro";
import { Icon } from "astro-icon/components";
import { stackGroups } from "../../utils/stack";
---

<Section
  id="stack"
  eyebrow="Stack"
  title="What I work in, by depth"
  lead="Java and Spring Boot on a SQL database is what I write at work every day. The groups below go in order of how much I have actually shipped with each."
>
  <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2">
    {stackGroups.map((group, i) => (
      <div class="bg-surface-1 p-5 sm:p-7" data-reveal data-reveal-index={i}>
        <div class="flex items-baseline gap-3">
          <span class="font-mono text-[11px] tracking-widest text-accent">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="font-display text-lg font-semibold text-ink">{group.layer}</h3>
        </div>

        <p class="mt-2.5 text-[1rem] leading-relaxed text-ink-2">{group.note}</p>

        <ul class="mt-6 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li
              class="group inline-flex items-center gap-2 rounded-lg border border-line bg-surface-2/70 px-3 py-2 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:bg-surface-2"
            >
              <Icon name={item.icon} class="h-4 w-4 text-ink-2 transition-colors duration-200 group-hover:text-accent" />
              <span class="font-mono text-[13px] text-ink">{item.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
