---
export interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<span
  class:list={[
    "inline-flex items-center rounded-md border border-line bg-surface-2/60",
    "px-2.5 py-1 font-mono text-[12px] tracking-wide text-ink-2",
    "transition-colors duration-200 group-hover:border-line-strong",
    cls,
  ]}
><slot /></span>
