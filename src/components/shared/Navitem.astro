---
export interface Props {
    href: string;
    text: string;
}

const { href, text } = Astro.props;
---

<li>
    <a href={href} class="relative py-2.5 group">
        <span>{text}</span>
        <span class="absolute w-full h-0.5 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out bottom-0 left-0"></span>
    </a>
</li>
