---
export interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "ghost";
  download?: string | boolean;
  target?: string;
  rel?: string;
  class?: string;
}
const {
  href, type = "button", variant = "primary",
  download, target, rel, class: cls = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3 " +
  "text-sm font-medium transition-colors duration-200";

const styles = {
  primary: "bg-accent text-accent-fg hover:bg-accent-hi",
  ghost:   "border border-line-strong text-ink hover:border-accent hover:text-accent",
}[variant];
---
{href ? (
  <a href={href} download={download} target={target} rel={rel} class:list={[base, styles, cls]}>
    <slot />
  </a>
) : (
  <button type={type} class:list={[base, styles, cls]}>
    <slot />
  </button>
)}
